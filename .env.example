# Copy this file to .env and edit it. .env is git-ignored, so your TV's address stays on your computer.
# Your TV's IP address: on the TV, Settings > Network & Internet > your Wi-Fi network.
# Port 5555 is added for you if you leave it off.
TV_IP=192.0.2.10
# adb command or full path (Mac with Homebrew: /opt/homebrew/bin/adb)
ADB=adb
